# ── App ───────────────────────────────────────────────────
SECRET_KEY=generate-with-openssl-rand-hex-32
DEBUG=false

# ── Database ──────────────────────────────────────────────
DB_PASSWORD=your-strong-db-password
DATABASE_URL=postgresql+asyncpg://avaniko:your-strong-db-password@postgres:5432/avaniko_platform

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:your-redis-password@redis:6379/0

# ── RunPod (NEVER expose these) ───────────────────────────
RUNPOD_GATEWAY_URL=http://your-runpod-ip:2222
RUNPOD_API_KEY=sk-ava-your-internal-runpod-key

# ── External AI providers (optional) ─────────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=["https://yourdomain.com","https://app.yourdomain.com"]
